generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("users")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model Sitio {
  id                String    @id
  gpwId             String    @unique @map("gpw_id")
  lugar             String
  departamento      String
  longitud          Decimal   @db.Decimal
  latitud           Decimal   @db.Decimal
  distanciaAguaM    Decimal?  @map("distancia_agua_m") @db.Decimal
  tipoAguaCercana   String    @map("tipo_agua_cercana")
  poblacion1km      Int       @map("poblacion_1km")
  poblacion5km      Int       @map("poblacion_5km")
  elevacionM        Decimal   @map("elevacion_m") @db.Decimal
  pendienteGrados   Decimal?  @map("pendiente_grados") @db.Decimal
  tipo              String
  verificadoEnCampo Boolean   @map("verificado_en_campo")
  licencia          String
  fuentes           String
  reportes          Reporte[]

  @@map("sitios")
}

model Reporte {
  id           String   @id @default(uuid()) @db.Uuid
  sitioId      String   @map("sitio_id")
  resultado    String
  fechaVisita  DateTime @map("fecha_visita") @db.Date
  comentario   String?
  contacto     String?  @db.VarChar(200)
  creadoEn     DateTime @default(now()) @map("creado_en")
  sitio        Sitio    @relation(fields: [sitioId], references: [id])
  fotos        Foto[]

  @@index([sitioId])
  @@map("reportes")
}

model Foto {
  id        String   @id @default(uuid()) @db.Uuid
  reporteId String   @map("reporte_id") @db.Uuid
  url       String
  creadoEn  DateTime @default(now()) @map("creado_en")
  reporte   Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId])
  @@map("fotos")
}

model Comentario {
  id       String   @id @default(uuid()) @db.Uuid
  texto    String   @db.VarChar(200)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([creadoEn(sort: Desc)])
  @@map("comentarios")
}

model Seccion {
  id         String      @id
  nombre     String      @unique
  propuestas Propuesta[]

  @@map("secciones")
}

model Propuesta {
  id        String   @id @default(uuid()) @db.Uuid
  seccionId String   @map("seccion_id")
  texto     String   @db.VarChar(250)
  meGusta   Int      @default(0) @map("me_gusta")
  creadoEn  DateTime @default(now()) @map("creado_en")
  seccion   Seccion  @relation(fields: [seccionId], references: [id])

  @@index([seccionId])
  @@index([creadoEn(sort: Desc)])
  @@map("propuestas")
}
