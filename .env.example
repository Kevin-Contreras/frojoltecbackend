PORT=3000
NODE_ENV=development

# Credenciales de Vercel Postgres / Neon
# Al enlazar Vercel Postgres a tu proyecto en Vercel, estas variables se configuran automáticamente:
POSTGRES_PRISMA_URL="postgres://default:password@ep-xyz-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-xyz.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Si usas una base de datos local en desarrollo:
# POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/frojoltec_db"
# POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/frojoltec_db"
